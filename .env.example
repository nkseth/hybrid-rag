# --- Database (libSQL) ---
# Local: leave unset → file:./data/rag.db
# Vercel: create a free Turso DB (turso db create rag) and set both:
# DATABASE_URL=libsql://rag-<you>.turso.io
# DATABASE_AUTH_TOKEN=

# --- LLM via OpenRouter (free models) ---
# Get a key at openrouter.ai/keys. Without it the app still runs: heuristic graph extraction + extractive answers.
# Free models are rate-limited (~20 req/min); failures fall back to openrouter/free, then to the heuristic.
# OPENROUTER_API_KEY=
# ANSWER_MODEL=nvidia/nemotron-3.5-super-vl:free
# FAST_MODEL=nvidia/nemotron-3.5-super-vl:free

# --- Cron auth (Vercel sets this header automatically for cron jobs) ---
# CRON_SECRET=
